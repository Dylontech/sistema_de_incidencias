# ------------------------------------------------------------
# Configuración del sistema de incidencias.
#
# El archivo sirve para DOS usos distintos:
#   1. `cp .env.example .env`         -> variables de docker compose (raíz)
#   2. `cp .env.example backend/.env` -> arranque en el host (npm run dev)
#
# Ojo: las variables ya presentes en el entorno TIENEN PRIORIDAD sobre
# backend/.env (dotenv no sobrescribe). Si algo «no respeta» la configuración,
# revisa primero: env | grep -E "^(PORT|DB_|STORAGE_DRIVER|APP_PORT)"
# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------
# Seguridad
# ------------------------------------------------------------
# Cambia este valor en producción (cadena larga y aleatoria, 32+ caracteres).
# El arranque se niega a levantar con NODE_ENV=production si sigue siendo el
# valor de ejemplo.
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=8h

# Confianza en cabeceras X-Forwarded-* (IP real del cliente).
#   false    -> la app se publica directamente (por omisión, es lo correcto con
#               docker compose)
#   1        -> hay UN proxy inverso delante (Nginx, Traefik…)
#   <IP/CIDR>-> lista de proxies fiables
# No lo pongas a `true`: cualquiera podría falsear su IP.
TRUST_PROXY=false

# Actívalo solo si la aplicación se sirve por HTTPS: añade HSTS y
# upgrade-insecure-requests. Con HTTP a secas dejaría la interfaz sin estilos.
ASUMIR_HTTPS=false

# Política de contenidos: 'estricto' (por omisión) no admite nada en línea.
# 'laxo' permite estilos en línea y solo sirve para depurar.
CSP_MODO=estricto

# Límites de peticiones por ventana (por omisión, 900 en 15 minutos).
# RATE_LIMIT_ACTIVO=false lo desactiva por completo (no recomendado).
RATE_LIMIT_ACTIVO=true
# RATE_LIMIT_VENTANA_MS=900000
# RATE_LIMIT_MAX_GENERAL=900
# RATE_LIMIT_MAX_AUTH=10
# RATE_LIMIT_MAX_REGISTRO=5
# RATE_LIMIT_MAX_ANONIMO=20
# RATE_LIMIT_MAX_ESCRITURA=20
# RATE_LIMIT_MAX_UPLOADS=30

# Tamaño máximo del cuerpo JSON (bytes). El respaldo del monolito es la única
# ruta con un límite grande (MAX_IMPORTACION_BYTES).
# MAX_JSON_BYTES=1048576
# MAX_IMPORTACION_BYTES=104857600

# Consentimiento legal obligatorio (términos + aviso de privacidad).
# TERMINOS_EXIGIR=false desactiva el middleware (solo para depuración local).
TERMINOS_EXIGIR=true
# Activa el bloqueo también en NODE_ENV=test para pruebas dedicadas.
# TERMINOS_EXIGIR_EN_PRUEBAS=false

# ------------------------------------------------------------
# Almacenamiento
#   mysql -> MariaDB vía Knex (por defecto, también en Docker)
#   json  -> archivos JSON en backend/data (sin base de datos)
# ------------------------------------------------------------
STORAGE_DRIVER=json

# ------------------------------------------------------------
# Rutas (opcionales, por defecto relativas a backend/)
# ------------------------------------------------------------
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# ------------------------------------------------------------
# MySQL / MariaDB (necesario con STORAGE_DRIVER=mysql)
#
#   Dentro del contenedor los fija compose.yaml: DB_HOST=mariadb, DB_PORT=3306.
#   Desde el host, contra la base del contenedor: 127.0.0.1 y el puerto que
#   publica DB_PORT_HOST (3310 por omisión).
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=incidencias
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=incidencias
DB_CHARSET=utf8mb4

# ------------------------------------------------------------
# Docker (solo lo lee docker compose desde el .env de la raíz)
# ------------------------------------------------------------
# Puerto público de la aplicación en la máquina (el contenedor usa 3000).
APP_PORT=3100
# Interfaz en la que se publica. Por omisión solo el propio equipo
# (127.0.0.1). Usa 0.0.0.0 para probarla desde el móvil u otro equipo de la red,
# asumiendo que queda accesible para toda la red local.
APP_BIND=127.0.0.1
# Puerto de MariaDB publicado únicamente en 127.0.0.1, para desarrollar en el
# host contra la base del contenedor. No se expone a la red local.
# 3310: en esta máquina el 3306 y el 3307 ya están ocupados.
DB_PORT_HOST=3310
# Contraseña del usuario de la aplicación dentro de MariaDB (debe coincidir
# con DB_PASSWORD) y del usuario root del contenedor.
DB_ROOT_PASSWORD=cambia-esta-clave-de-root

# ------------------------------------------------------------
# Límite de evidencia (bytes). La evidencia es solo de fotografías:
# el video se retiró del formulario y el servidor lo rechaza.
# ------------------------------------------------------------
MAX_FOTO_BYTES=104857600

# ------------------------------------------------------------
# Correo saliente (informes públicos, contacto y mensajería)
#
# Open source y sin servicios de pago: cualquier SMTP sirve (Gmail con
# contraseña de aplicación, Zoho, Outlook, servidor propio…). Sin SMTP_HOST
# o con MAIL_DRY_RUN=true no se envía nada: se registra como «simulado».
#
# Tutorial completo en CAMBIOS_INSTALACION.txt.
# ------------------------------------------------------------
MAIL_ACTIVO=true
MAIL_DRY_RUN=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sistema de Incidencias <no-reply@tu-dominio.mx>
MAIL_REPLY_TO=
# Límite de envíos por minuto para no saturar el SMTP ni el servidor.
CORREO_MAX_POR_MINUTO=20
CORREO_MAX_REINTENTOS=3

# URL pública absoluta (para los enlaces de verificación y baja de los correos).
# En Docker con el puerto 3100: http://localhost:3100
URL_PUBLICA=http://localhost:3100

# Formularios públicos: solicitudes por IP y consultas de estado por hora.
LIMITE_SOLICITUDES_HORA=5
LIMITE_CONSULTAS_HORA=30
RATE_LIMIT_MAX_PUBLICO=10

