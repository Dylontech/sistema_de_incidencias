{
  "name": "sistema-de-incidencias",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Incidencias Municipales — backend Express (MVC) + frontend JavaScript modular",
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend run start",
    "test": "npm --prefix backend test",
    "test:mysql": "npm --prefix backend run test:mysql --",
    "db:pruebas": "npm --prefix backend run db:pruebas --",
    "db:pruebas:down": "npm --prefix backend run db:pruebas:down --",
    "migrate": "npm --prefix backend run migrate",
    "migrate:rollback": "npm --prefix backend run migrate:rollback",
    "seed": "npm --prefix backend run seed",
    "importar-inegi": "npm --prefix backend run importar-inegi",
    "importar-vialidades": "npm --prefix backend run importar-vialidades --",
    "vendorizar-frontend": "npm --prefix backend run vendorizar-frontend",
    "migrar-catalogo": "npm --prefix backend run migrar-catalogo",
    "datos-demo": "npm --prefix backend run datos-demo",
    "desktop": "npm --prefix desktop start",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dist:win": "npm --prefix desktop run dist:win",
    "desktop:dist:linux": "npm --prefix desktop run dist:linux",
    "mapas:offline": "npm --prefix desktop run mapas:generar"
  }
}
